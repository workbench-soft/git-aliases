#!/usr/bin/env bash
# Stage all, commit, push.
# Flags: -f force-with-lease, -p skip hooks, -s skip staging.
# Everything after -- is message, even if it starts with a dash.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

synopsis='[-f] [-p] [-s] [--] <message>'
flag_help=(
	'-f  push with --force-with-lease'
	'-p  skip the commit and push hooks'
	'-s  skip staging, commit whatever is staged already'
	'--  makes everything after it message, even if it starts with a dash'
)

commit_flags=()
push_flags=()
words=()
stage_all=1
past_dashes=0
for arg in "$@"; do
	if ((past_dashes)); then
		words+=("$arg")
		continue
	fi
	case $arg in
		-h | --help) show_usage "$synopsis" "${flag_help[@]}" ;;
		--) past_dashes=1 ;;
		-f) push_flags+=(--force-with-lease) ;;
		-p)
			commit_flags+=(--no-verify)
			push_flags+=(--no-verify)
			;;
		-s) stage_all=0 ;;
		-*)
			printf 'unknown flag: %s\n\n' "$arg" >&2
			show_usage "$synopsis" "${flag_help[@]}"
			;;
		*) words+=("$arg") ;;
	esac
done

((${#words[@]})) || show_usage "$synopsis" "${flag_help[@]}"

if ((stage_all)); then
	trace_run git add -A
fi

if git diff --cached --quiet; then
	echo 'nothing to commit, pushing anyway'
else
	trace_run git commit ${commit_flags[@]+"${commit_flags[@]}"} -m "${words[*]}"
fi

# A branch without an upstream gets one on this push.
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
	trace_run git push ${push_flags[@]+"${push_flags[@]}"}
else
	trace_run git push ${push_flags[@]+"${push_flags[@]}"} -u "$(pick_remote)" HEAD
fi
