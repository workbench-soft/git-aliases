#!/usr/bin/env bash
# Pick branches and worktrees with fzf (TAB for several), then delete them.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"
# shellcheck source=bin/_prune.sh
. "$(dirname "$0")/_prune.sh"
need_command fzf

read_worktrees
choices=$(prune_candidates all)
if [[ -z $choices ]]; then
	echo 'No branches or worktrees to delete.'
	exit 0
fi

# fzf shows columns 1 and 3, and hides the worktree slot in column 2.
# Esc, or Enter on an empty pick, ends the alias with nothing deleted.
picked=$(
	printf '%s\n' "$choices" |
		fzf --multi --height=40% --reverse \
			--delimiter=$'\t' --with-nth=1,3.. \
			--header='TAB to multi-select, Enter to delete branches and worktree folders' \
			--preview "$log_preview"
) || exit 0
[[ -n $picked ]] || exit 0

prune_selected "$picked"
