#!/usr/bin/env bash
# Fetch and rebase onto the default branch.
# -c rebases onto the upstream of the current branch, or pass a branch name.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)

args='[-c | <branch>]'
notes=(
	'no arguments  rebase onto the default branch of the remote'
	'-c            rebase onto the upstream of the current branch'
	'<branch>      rebase onto that branch on the remote'
)

case ${1:-} in
	-h | --help) show_usage "$args" "${notes[@]}" ;;
	-c) target='@{u}' ;;
	'') target="$remote/$(remote_head_branch "$remote")" ;;
	-*)
		printf 'unknown flag: %s\n\n' "$1" >&2
		show_usage "$args" "${notes[@]}"
		;;
	*) target="$remote/$1" ;;
esac

trace_run git fetch "$remote"
trace_run git rebase "$target"
