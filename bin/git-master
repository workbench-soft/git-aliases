#!/usr/bin/env bash
# Drop local changes (asks first), fetch, hard reset to the default branch.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)
target=$(remote_head_branch "$remote")

if [[ -n $(git status --porcelain) ]]; then
	echo 'You have local changes:'
	git status --short
	ask_yes 'Drop all local changes?' || abort 'aborted'
	trace_run git reset --hard HEAD
	trace_run git clean -fd
fi

trace_run git fetch "$remote" "$target"

if git show-ref --verify --quiet "refs/heads/$target"; then
	trace_run git checkout "$target"
else
	trace_run git checkout -b "$target" --track "$remote/$target"
fi

trace_run git reset --hard "$remote/$target"
