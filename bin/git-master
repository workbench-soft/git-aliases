#!/usr/bin/env bash
# Drop local changes and commits (asks first), fetch, hard reset to the default branch.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)
target=$(remote_head_branch "$remote")
need_plain_branch "$target"

# git refuses to check out a branch another worktree holds, so stop before any change.
holder=$(git for-each-ref --format='%(worktreepath)' "refs/heads/$target")
if [[ -n $holder && $holder != "$(git rev-parse --show-toplevel)" ]]; then
	abort "$target is checked out at $holder, run git master there"
fi

# The fetch comes first, so both questions come before anything is dropped.
trace_run git fetch "$remote" "$target"

if git show-ref --verify --quiet "refs/heads/$target"; then
	unpushed=$(git log --oneline "$remote/$target..refs/heads/$target")
	if [[ -n $unpushed ]]; then
		echo "$target has commits that $remote/$target lacks:"
		printf '%s\n' "$unpushed"
		ask_yes 'Drop these commits?' || abort 'aborted'
	fi
fi

# Commits made on a detached HEAD sit on no branch, so the checkout would drop them.
if ! git symbolic-ref --quiet HEAD >/dev/null; then
	stray=$(git log --oneline HEAD --not --branches --remotes --tags)
	if [[ -n $stray ]]; then
		echo 'HEAD is detached, with commits no branch holds:'
		printf '%s\n' "$stray"
		ask_yes 'Drop these commits?' || abort 'aborted'
	fi
fi

if [[ -n $(git status --porcelain) ]]; then
	echo 'You have local changes:'
	git status --short
	ask_yes 'Drop all local changes?' || abort 'aborted'
	trace_run git reset --hard HEAD
	trace_run git clean -fd
fi

if git show-ref --verify --quiet "refs/heads/$target"; then
	trace_run git checkout "$target"
else
	trace_run git checkout -b "$target" --track "$remote/$target"
fi

trace_run git reset --hard "$remote/$target"
