#!/usr/bin/env bash
# Drop local changes (asks first), fetch, hard reset to the default branch.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)
branch=$(remote_head_branch "$remote")

if [ -n "$(git status --porcelain)" ]; then
	echo 'You have local changes:'
	git status --short
	ask_yes 'Drop all local changes?' || abort 'aborted'
	trace_run git reset --hard HEAD
	trace_run git clean -fd
fi

trace_run git fetch "$remote" "$branch"

if git show-ref --verify --quiet "refs/heads/$branch"; then
	trace_run git checkout "$branch"
else
	trace_run git checkout -b "$branch" --track "$remote/$branch"
fi

trace_run git reset --hard "$remote/$branch"
