#!/usr/bin/env bash
# Pick a local branch with fzf and switch to it, worktrees included.
# A branch checked out in another worktree can't be switched to in place, so the
# path is printed as "__cd__ <path>" and the shell function from the README
# turns that into a real cd.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"
need_command fzf

here=$(git rev-parse --show-toplevel)

main() {
	local choice branch home
	choice=$(picker_lines | fzf --ansi --height=40% --reverse --prompt='branch> ' --preview "$log_preview") || exit 0
	[[ -n $choice ]] || exit 0
	branch=${choice%% *}

	home=$(worktree_of "$branch")
	if [[ -n $home && $home != "$here" ]]; then
		trace "$branch is checked out at $home"
		printf '__cd__ %s\n' "$home"
		exit 0
	fi
	trace_run git checkout "$branch"
}

# Newest branch first, each followed by the folder of the worktree that holds it.
picker_lines() {
	{
		held_branches
		git for-each-ref --sort=-committerdate --format='B%09%(refname:short)' refs/heads/
	} | awk -F'\t' -v here="$here" '
		$1 == "W" { folder[$2] = $3; next }
		{
			where = folder[$2]
			if (where == "") print $2
			else if (where == here) printf "%-50s \033[38;5;240m(this worktree)\033[0m\n", $2
			else printf "%-50s \033[38;5;240m%s\033[0m\n", $2, where
		}'
}

# "W<tab><branch><tab><folder>" for each branch a worktree has checked out.
held_branches() {
	git worktree list --porcelain |
		awk '/^worktree /{folder = substr($0, 10)} /^branch refs\/heads\//{print "W\t" substr($0, 19) "\t" folder}'
}

worktree_of() {
	git worktree list --porcelain |
		awk -v ref="refs/heads/$1" '
			/^worktree /{folder = substr($0, 10)}
			/^branch /{if (substr($0, 8) == ref) {print folder; exit}}'
}

main
