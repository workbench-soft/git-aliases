#!/usr/bin/env bash
# Create a branch, name normalized to lowercase-with-hyphens.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

synopsis='<branch name>'
flag_help=(
	'the name is lowercased, and anything but a-z 0-9 / _ . - becomes a hyphen'
	'git cb "Fix the Parser!" creates fix-the-parser'
)

case ${1:-} in
	-h | --help) show_usage "$synopsis" "${flag_help[@]}" ;;
esac

# A run of other characters turns into one hyphen. Git refuses "..", "/." and
# a dot or slash at either end, so those go too.
slug=$(printf '%s' "$*" |
	tr '[:upper:]' '[:lower:]' |
	sed -E 's|[^a-z0-9/_.-]+|-|g; s/-+/-/g; s/[.][.]+/./g; s|/+|/|g; s|/[.]+|/|g; s|^[-./]+||; s|[-./]+$||')

[[ -n $slug ]] || show_usage "$synopsis" "${flag_help[@]}"

trace_run git checkout -b "$slug"
