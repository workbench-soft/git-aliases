#!/usr/bin/env bash
# Pull with rebase from the remote branch matching the current one.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

current=$(git branch --show-current)
[[ -n $current ]] || abort 'detached HEAD, nothing to pull'
need_plain_branch "$current"

# An abort inside "$(...)" in the argument list would not stop the script.
remote=$(pick_remote)

# Naming the remote branch outright lets a branch with no upstream pull too.
trace_run git pull --rebase "$remote" "$current"
