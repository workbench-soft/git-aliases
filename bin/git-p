#!/usr/bin/env bash
# Pull with rebase from the remote branch matching the current one.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

branch=$(git branch --show-current)
[ -n "$branch" ] || abort 'detached HEAD, nothing to pull'

trace_run git pull --rebase "$(pick_remote)" "$branch"
