#!/usr/bin/env bash
# Soft reset to the merge base with the default branch, keeping changes staged.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)
fork_point=$(git merge-base HEAD "$remote/$(remote_head_branch "$remote")")

trace_run git reset --soft "$fork_point"
