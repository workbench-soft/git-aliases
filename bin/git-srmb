#!/usr/bin/env bash
# Soft reset to the merge base with the default branch, keeping changes staged.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

remote=$(pick_remote)
target="$remote/$(remote_head_branch "$remote")"
base=$(git merge-base HEAD "$target")

trace_run git reset --soft "$base"
