#!/usr/bin/env bash
# Checkout a branch, fetching it from origin when it isn't local yet.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

args='<branch>'
notes=(
	'switches to the branch, or fetches it from the remote when it is not local yet'
)

case ${1:-} in
	-h | --help) show_usage "$args" "${notes[@]}" ;;
esac

branch=${1:-}
[ -n "$branch" ] || show_usage "$args" "${notes[@]}"

if git show-ref --verify --quiet "refs/heads/$branch"; then
	trace_run git checkout "$branch"
else
	remote=$(pick_remote)
	trace_run git fetch "$remote" "$branch"
	trace_run git checkout -b "$branch" "$remote/$branch"
fi
