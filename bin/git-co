#!/usr/bin/env bash
# Checkout a branch, fetching it from origin when it isn't local yet.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

synopsis='<branch>'
flag_help=(
	'switches to the branch, or fetches it from the remote when it is not local yet'
)

wanted=${1:-}
case $wanted in
	-h | --help | '') show_usage "$synopsis" "${flag_help[@]}" ;;
esac

if git show-ref --verify --quiet "refs/heads/$wanted"; then
	trace_run git checkout "$wanted"
	exit 0
fi

remote=$(pick_remote)
# The full refspec skips a tag of the same name, and it fills $remote/<branch>
# even in a clone made with --single-branch.
trace_run git fetch "$remote" "+refs/heads/$wanted:refs/remotes/$remote/$wanted"
trace_run git checkout -b "$wanted" "$remote/$wanted"
