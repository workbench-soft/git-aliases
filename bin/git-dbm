#!/usr/bin/env bash
# Prune remotes, then offer to delete branches and worktrees whose upstream is gone.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"
# shellcheck source=bin/_prune.sh
. "$(dirname "$0")/_prune.sh"

# After the prune, git marks a branch whose remote branch is deleted as [gone].
trace_run git fetch --prune

read_worktrees
doomed=$(prune_candidates gone)
if [[ -z $doomed ]]; then
	echo 'No deletable branches or worktrees with a gone upstream.'
	exit 0
fi

echo 'Branches and worktrees whose remote branch was deleted:'
awk -F'\t' '{print "  " $1 " " $3}' <<<"$doomed"
ask_yes 'Delete these branches and worktree folders?' || abort 'aborted'

prune_selected "$doomed"
