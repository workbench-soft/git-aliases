#!/usr/bin/env bash
# List every alias in this repo with its description.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

root=$(cd "$(dirname "$0")/.." && pwd)
config="$root/aliases.gitconfig"
[ -f "$config" ] || abort "no aliases.gitconfig next to $0"

# The comment block under the shebang of a git-* script.
script_summary() {
	awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$1"
}

render() {
	local entry name value script line
	while IFS= read -r -d '' entry; do
		name=${entry%%$'\n'*}
		name=${name#alias.}
		value=${entry#*$'\n'}
		script=${value##*/}
		printf '%s%-8s%s %sbin/%s%s\n' "$CLR_COMMAND" "$name" "$CLR_OFF" "$CLR_FAINT" "$script" "$CLR_OFF"
		while IFS= read -r line; do
			printf '  %s%s%s\n' "$CLR_HINT" "$line" "$CLR_OFF"
		done < <(script_summary "$root/bin/$script")
		printf '\n'
	done < <(git config --file "$config" --null --get-regexp '^alias\.')
}

if [ -t 1 ] && command -v less >/dev/null 2>&1; then
	render | less -R
else
	render
fi
