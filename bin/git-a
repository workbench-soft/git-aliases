#!/usr/bin/env bash
# List every alias in this repo with its description.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

repo=$(cd "$(dirname "$0")/.." && pwd)
index="$repo/aliases.gitconfig"
[[ -f $index ]] || abort "no aliases.gitconfig next to $0"

main() {
	if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
		print_aliases | less -R
	else
		print_aliases
	fi
}

# git config -z prints each entry as "alias.<name>\n<command>\0".
print_aliases() {
	local entry alias_name script summary_line
	while IFS= read -r -d '' entry; do
		alias_name=${entry%%$'\n'*}
		alias_name=${alias_name#alias.}
		script=${entry##*/}
		printf '%s%-8s%s %sbin/%s%s\n' "$CLR_COMMAND" "$alias_name" "$CLR_OFF" "$CLR_FAINT" "$script" "$CLR_OFF"
		while IFS= read -r summary_line; do
			printf '  %s%s%s\n' "$CLR_HINT" "$summary_line" "$CLR_OFF"
		done < <(script_summary "$repo/bin/$script")
		printf '\n'
	done < <(git config --file "$index" --null --get-regexp '^alias\.')
}

# The comment lines right under the shebang, without their "# ".
script_summary() {
	awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$1"
}

main
