#!/usr/bin/env bash
# List every alias in this repo with its description.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

repo=$(cd "$(dirname "$0")/.." && pwd)
index="$repo/aliases.gitconfig"
[[ -f $index ]] || abort "no aliases.gitconfig next to $0"

main() {
	if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
		print_aliases | less -R
	else
		print_aliases
	fi
}

# git config -z prints each entry as "alias.<name>\n<command>\0". One awk reads
# every script, since a process per alias costs about 0.1 s on Windows.
print_aliases() {
	local entry alias_name
	while IFS= read -r -d '' entry; do
		alias_name=${entry%%$'\n'*}
		printf '%s\t%s\n' "${alias_name#alias.}" "${entry##*/}"
	done < <(git config --file "$index" --null --get-regexp '^alias\.') |
		awk -F'\t' -v bin="$repo/bin/" -v name="$CLR_COMMAND" -v faint="$CLR_FAINT" -v hint="$CLR_HINT" -v off="$CLR_OFF" '
		{
			printf "%s%-8s%s %sbin/%s%s\n", name, $1, off, faint, $2, off
			print_summary(bin $2)
			print ""
		}
		# The comment lines right under the shebang, without their "# ".
		function print_summary(file, line) {
			getline line <file
			while ((getline line <file) > 0 && line ~ /^#/) {
				sub(/^# ?/, "", line)
				printf "  %s%s%s\n", hint, line, off
			}
			close(file)
		}'
}

main
