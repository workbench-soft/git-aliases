#!/usr/bin/env bash
# Commit: non-flag arguments are joined into the message, flags go to git commit.
# Everything after -- is message, even if it starts with a dash.
set -euo pipefail
# shellcheck source=bin/_shared.sh
. "$(dirname "$0")/_shared.sh"

synopsis='[git commit flags] [--] <message>'
flag_help=(
	'flags are passed straight to git commit, say --amend or --no-verify'
	'-- makes everything after it message, even if it starts with a dash'
)

commit_flags=()
words=()
past_dashes=0
for arg in "$@"; do
	if ((past_dashes)); then
		words+=("$arg")
		continue
	fi
	case $arg in
		-h | --help) show_usage "$synopsis" "${flag_help[@]}" ;;
		--) past_dashes=1 ;;
		-*) commit_flags+=("$arg") ;;
		*) words+=("$arg") ;;
	esac
done

((${#words[@]})) || show_usage "$synopsis" "${flag_help[@]}"

# Bash before 4.4 calls an empty "${array[@]}" unbound under set -u.
trace_run git commit ${commit_flags[@]+"${commit_flags[@]}"} -m "${words[*]}"
